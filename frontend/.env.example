# FocusFlow frontend configuration (copy to `.env.local`). Only VITE_* variables reach the browser:
# never put secrets here.

# Base URL of the backend API (no trailing slash). Leave empty in development to use the Vite
# dev-server proxy (/api -> VITE_DEV_PROXY_TARGET), which avoids CORS entirely.
VITE_API_BASE_URL=

# Dev-server proxy target for /api, /health and /ready
VITE_DEV_PROXY_TARGET=http://localhost:8000


