# ---------------------------------------------------------------------------
# FocusFlow backend configuration. Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# development | test | production  (controls default log level and error detail)
ENVIRONMENT=development

# SQLAlchemy URL (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://focusflow:change-me@localhost:5432/focusflow
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# JWT signing secret - at least 32 chars. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret-value-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging. LOG_LEVEL defaults to DEBUG (development/test) or INFO (production).
# LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
LOG_TO_CONSOLE=true
# JSON console output is recommended for containers; set false for human readable dev output
LOG_JSON_CONSOLE=true
# Write access-log entries for /health and /ready (noisy with orchestrator probes)
LOG_HEALTH_CHECKS=false

# Rate limiting (slowapi). Use a redis:// URI when running multiple instances.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_STORAGE_URI=memory://

# AI coach (Groq, OpenAI-compatible API). The feature is disabled while the key is unset.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=30
